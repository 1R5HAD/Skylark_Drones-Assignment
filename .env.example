# Groq API key (free, no credit card) -- get one at https://console.groq.com
GROQ_API_KEY=

# monday.com API token: My profile (avatar) > Developers > My access tokens
MONDAY_API_TOKEN=

# Board IDs only -- just the number from the board's URL
# (monday.com/boards/<BOARD_ID>), not the full URL
MONDAY_WORK_ORDERS_BOARD_ID=
MONDAY_DEALS_BOARD_ID=
